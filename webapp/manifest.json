{
  "_version": "1.73.1",
  "sap.app": {
    "id": "pe.pucp.tesis.migodcu",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.34.0",
      "toolsId": "ae0348ca-cfb6-4f8d-93f2-62300014e114"
    },
    "dataSources": {
      "datosPrueba": {
        "uri": "model/datosPrueba.json",
        "type": "JSON"
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    },
    "fullWidth": true
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.136.24",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "pe.pucp.tesis.migodcu.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      },
      "datos": {
        "type": "sap.ui.model.json.JSONModel",
        "dataSource": "datosPrueba"
      },
      "resultado": {
        "type": "sap.ui.model.json.JSONModel"
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "pe.pucp.tesis.migodcu.view",
        "async": true,
        "viewPath": "pe.pucp.tesis.migodcu.view"
      },
      "routes": [
        {
          "name": "inicio",
          "pattern": ":?query:",
          "target": [
            "inicio"
          ]
        },
        {
          "name": "entradaOrden",
          "pattern": "entrada",
          "target": [
            "entradaOrden"
          ]
        },
        {
          "name": "entradaRegistro",
          "pattern": "entrada/{orden}",
          "target": [
            "entradaRegistro"
          ]
        },
        {
          "name": "salidaOrden",
          "pattern": "salida",
          "target": [
            "salidaOrden"
          ]
        },
        {
          "name": "salidaRegistro",
          "pattern": "salida/{orden}",
          "target": [
            "salidaRegistro"
          ]
        },
        {
          "name": "resultado",
          "pattern": "resultado/{flujo}/{documento}",
          "target": [
            "resultado"
          ]
        }
      ],
      "targets": {
        "inicio": {
          "id": "Inicio",
          "name": "Inicio",
          "level": 1
        },
        "entradaOrden": {
          "id": "EntradaOrden",
          "name": "EntradaOrden",
          "level": 2
        },
        "entradaRegistro": {
          "id": "EntradaRegistro",
          "name": "EntradaRegistro",
          "level": 3
        },
        "salidaOrden": {
          "id": "SalidaOrden",
          "name": "SalidaOrden",
          "level": 2
        },
        "salidaRegistro": {
          "id": "SalidaRegistro",
          "name": "SalidaRegistro",
          "level": 3
        },
        "resultado": {
          "id": "Resultado",
          "name": "Resultado",
          "level": 4
        }
      }
    },
    "rootView": {
      "viewName": "pe.pucp.tesis.migodcu.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
