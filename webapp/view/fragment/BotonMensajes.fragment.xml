<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <!-- EH-05: botón Mensajes del patrón MessagePopover (ícono de error y contador) -->
    <Button id="btnMensajes" icon="sap-icon://message-error" ariaHasPopup="Dialog"
        text="{= ${i18n>btnMensajes} + (${message>/}.length > 0 ? ' (' + ${message>/}.length + ')' : '') }"
        type="{= ${message>/}.length > 0 ? 'Negative' : 'Default' }" enabled="{= ${message>/}.length > 0 }"
        press=".onMensajes"/>
</core:FragmentDefinition>
