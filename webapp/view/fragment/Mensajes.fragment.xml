<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <MessagePopover id="mpMensajes" items="{message>/}" activeTitlePress=".onIrAlCampo"
        itemSelect=".onMensajeSeleccionado">
        <MessageItem type="{message>type}" title="{message>message}" description="{message>description}"
            activeTitle="{= ${message>controlIds}.length > 0 }">
            <link>
                <!-- Rótulos de la Tabla K1: «Ir al campo» / «Ir a la posición» (P101-02-E) y «Ver alternativas» (P261-02-E) -->
                <Link text="{parts: ['message>code', 'message>controlIds'], formatter: '.textoLinkMensaje'}"
                    visible="{= ${message>code} === 'STOCK' || ${message>controlIds}.length > 0 }" press=".onLinkMensaje"/>
            </link>
        </MessageItem>
    </MessagePopover>
</core:FragmentDefinition>
