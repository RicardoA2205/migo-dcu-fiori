<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="dlgResumenEntrada" title="{i18n>resumenTitulo}" contentWidth="50rem">
        <VBox class="sapUiSmallMargin">
            <Text text="{reg>/resumen/lineaOrden}"/>
            <Text text="{i18n>claseMov101}" class="sapUiTinyMarginTop"/>
            <Text text="{reg>/resumen/lineaFecha}" class="sapUiTinyMarginTop"/>
            <Table items="{reg>/resumen/posiciones}" class="sapUiSmallMarginTop">
                <columns>
                    <Column width="4rem"><Text text="{i18n>colPos}"/></Column>
                    <Column><Text text="{i18n>colMaterial}"/></Column>
                    <Column><Text text="{i18n>colDescripcion}"/></Column>
                    <Column hAlign="End"><Text text="{i18n>colCantidad}"/></Column>
                    <Column><Text text="{i18n>colUnidad}"/></Column>
                    <Column><Text text="{i18n>colAlmacen}"/></Column>
                </columns>
                <items>
                    <ColumnListItem>
                        <Text text="{reg>pos}"/>
                        <Text text="{reg>material}"/>
                        <Text text="{reg>descripcion}"/>
                        <Text text="{reg>cantidadRecibida}"/>
                        <Text text="{reg>unidad}"/>
                        <Text text="{reg>almacen}"/>
                    </ColumnListItem>
                </items>
            </Table>
            <Title text="{reg>/resumen/aRegistrar}" class="sapUiSmallMarginTop"/>
            <Text text="{reg>/resumen/noRegistradas}"/>
            <MessageStrip type="Warning" showIcon="true" text="{reg>/resumen/aviso}" class="sapUiSmallMarginTop"/>
        </VBox>
        <buttons>
            <Button text="{i18n>btnVolverCorregir}" type="Transparent" press=".onVolverCorregir"/>
            <Button id="btnConfirmarEntrada" text="{i18n>btnConfirmar}" type="Emphasized" press=".onConfirmar"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>
